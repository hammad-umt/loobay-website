# Copy the signed release APK to public/downloads/loobay.apk before enabling this path.
# HTTPS store/CDN URLs are also supported. Plain HTTP is accepted only on localhost.
ANDROID_APP_URL=/downloads/loobay.apk
IOS_APP_URL=

# Server-only Supabase credentials for private issue reports.
# Use the current sb_secret_... key. Never add NEXT_PUBLIC_ to this variable.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Credentials for the protected /admin/issues page.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Download counters still use this local file on a persistent Node server.
# Relative paths are resolved from the Next.js project directory.
LOOBAY_DATA_FILE=data/site-data.json
NEXT_PUBLIC_SUPABASE_URL=https://sgbzijtnfipjqcetymky.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_qhaB5B5IVULF1u9op10n1Q_QWy95ZMw
